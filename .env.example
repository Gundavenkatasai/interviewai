# ==============================================================================
# Interview AI — Master Environment Configuration Template (.env.example)
# ==============================================================================
# WARNING: Never commit real production secrets, passwords, or API keys to git.
# Leave secret values empty in this template. Fill them in your deployment platform
# (e.g. Render, Railway, AWS ECS, Vercel, Docker Secrets).
# ==============================================================================

# ── 1. General & Runtime Environment ──────────────────────────────────────────
# Options: "development" | "test" | "production"
NODE_ENV=production

# Backend Fastify API HTTP Port
PORT=8001

# Primary Production Frontend URL (supports comma-separated origins for CORS)
FRONTEND_URL=https://interviewai.app,https://www.interviewai.app

# ── 2. Database & State Storage ───────────────────────────────────────────────
# Production MongoDB connection string (MongoDB Atlas cluster or replica set)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/?retryWrites=true&w=majority

# Production database name
MONGODB_DB_NAME=interviewai_production

# Optional Redis connection string for distributed caching & queues
REDIS_URL=redis://localhost:6379

# ── 3. Authentication & Security (Server-Only Secrets) ────────────────────────
# High-entropy JWT signing secret (minimum 32 random characters; REQUIRED in prod)
JWT_SECRET=

# JWT token expiration window (e.g. "7d", "24h", "15m")
JWT_EXPIRES_IN=7d

# Session secret for cookie signature
SESSION_SECRET=

# ── 4. AI & Inference Provider Credentials (Server-Only) ──────────────────────
# Groq Cloud API Key for ultra-fast Whisper speech transcription & inference
GROQ_API_KEY=

# OpenAI API Key (GPT-4o / embeddings)
OPENAI_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Optional Qwen endpoint configuration
QWEN_BASE_URL=
QWEN_API_KEY=

# Apify Actor token for automated external job board ingestion
APIFY_TOKEN=

# ── 5. Client-Side Web Application Settings (Vite - Public) ───────────────────
# Public API Base URL consumed by browser client (NO SECRETS ALLOWED)
VITE_API_URL=https://api.interviewai.app

# Public WebSocket endpoint for real-time interview audio & chat (WSS in prod)
VITE_WS_URL=wss://api.interviewai.app
