FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY apps/api-node/package*.json ./apps/api-node/
COPY packages/ ./packages/

RUN npm install --legacy-peer-deps

COPY apps/api-node/ ./apps/api-node/
RUN cd apps/api-node && npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=8001

COPY --from=builder /app/apps/api-node/dist ./dist
COPY --from=builder /app/apps/api-node/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 8001
CMD ["node", "dist/server.js"]
