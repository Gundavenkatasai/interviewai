# ==============================================================================
# Interview AI API (apps/api-node) — Environment Template (.env.example)
# ==============================================================================

NODE_ENV=production
PORT=8001
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=interviewai_production

# Security - Minimum 32 characters, fail-fast on startup in production
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://interviewai.app,https://www.interviewai.app

# Optional AI Providers & Ingestion
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_BASE_URL=
QWEN_API_KEY=
APIFY_TOKEN=
REDIS_URL=
